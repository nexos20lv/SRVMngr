{
  "name": "srvmngr",
  "version": "1.0.0",
  "description": "Panneau de gestion multi-VPS (SSH, Docker, systemd, nginx, fichiers, terminal)",
  "main": "./out/main/index.js",
  "author": "Pierre",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "tsx scripts/smoke.mts",
    "smoke:tools": "tsx scripts/smoke-tools.mts",
    "smoke:security": "tsx scripts/smoke-security.mts",
    "smoke:security:apply": "tsx scripts/smoke-sec-apply.mts",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
